    "cf-typegen": "wrangler types",
    "test:drive": "bash scripts/run-drive-tests.sh",
    "test:both-partial": "bash scripts/run-both-partial.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251104.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
