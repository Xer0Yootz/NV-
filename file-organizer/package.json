{
  "name": "nv-file-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "Drop box Worker for Prof. Indigo stills (R2 + Drive dual-save). Do not deploy without Jasmine's word.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test:local": "bash scripts/run-local-tests.sh",
